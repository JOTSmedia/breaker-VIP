# ============================================================
# Breaker Billiards rewards — settings
#
# You normally never copy this by hand: `npm run setup` creates
# server/.env from it and fills in the admin password (as a hash)
# and the session secret.
#
# server/.env holds secrets. Never commit it, email it or share it.
# ============================================================

# --- Admin login for the staff console (admin.html) — required ---
ADMIN_USER=admin
# Written by `npm run setup`: a scrypt HASH of the password, not the password.
ADMIN_PASS_HASH=
# Alternative for hosting dashboards: a plain password (8+ characters),
# hashed in memory when the server starts. Leave blank if the hash is set.
ADMIN_PASS=

# --- Optional legacy staff logins (blank = that login is switched off) ---
# Prefer creating staff logins in the staff console (Staff tab): they are
# stored hashed in the data folder and can be switched off or reset there.
# These still work if set. Usernames: manager / frontdesk (or desk) /
# barmanager (or bar). Bar logins get Front Desk permissions (look up, sign
# up, add points, redeem); adjustments, tiers, closing accounts, export and
# minting/voiding cards need a manager or the admin.
MANAGER_PASS=
DESK_PASS=
BAR_PASS=

# --- Behind a proxy / Cloudflare Tunnel (blank = off, the safe default) ---
# Staff-login throttling counts failed attempts per client address. Behind a
# Cloudflare Tunnel every request comes from 127.0.0.1, so set
# TRUST_PROXY=cloudflare to use Cloudflare's CF-Connecting-IP header instead.
# Only do that when the tunnel is the ONLY way in (keep HOST=127.0.0.1).
TRUST_PROXY=

# Note: values already set in the real environment (systemd Environment=,
# a hosting dashboard, the shell) WIN over this file; it never overrides them.

# --- Network ---
PORT=4400
# 127.0.0.1 = only this computer can connect (safe default).
# 0.0.0.0   = reachable from your network / the internet (use behind HTTPS).
HOST=127.0.0.1

# --- Where the database lives. Blank = server/data inside this folder.
# On a host with a persistent disk, point this at the disk, e.g. /data
DATA_DIR=

# --- Only needed if the customer page is hosted on a DIFFERENT site
# (e.g. GitHub Pages). Comma-separate exact origins. Never "*".
ALLOW_ORIGIN=

# --- Signs login sessions. setup fills this in. Changing it signs everyone out.
SESSION_SECRET=

# --- POS terminals (Toast / CueT webhooks). Blank = terminals are locked out.
# Terminals must send this value in an "X-POS-Key" header.
POS_WEBHOOK_KEY=
