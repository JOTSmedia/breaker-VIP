# ============================================================
# Breaker Billiards rewards — settings
#
# You normally never copy this by hand: `npm run setup` creates
# server/.env from it and fills in the admin password (as a hash)
# and the session secret.
#
# server/.env holds secrets. Never commit it, email it or share it.
# ============================================================

# --- Admin login for the staff console (admin.html) — required ---
ADMIN_USER=admin
# Written by `npm run setup`: a scrypt HASH of the password, not the password.
ADMIN_PASS_HASH=dc018f13d27ad321ec7bba0ed65a2984:2db3b27bda8bdf37341fe42f411ddc41b754ab928ab263afb32d1fb45ba79c1908b25ff23302b7266714ce76ae7ac33f11f9b2f5dae25fc26da55a1a3cdfc6fa
# Alternative for hosting dashboards: a plain password (8+ characters),
# hashed in memory when the server starts. Leave blank if the hash is set.
ADMIN_PASS=

# --- Optional extra staff logins (blank = that login is switched off) ---
# Usernames: manager / frontdesk (or desk) / barmanager (or bar).
# Front desk and bar staff can look up, sign up, add points and redeem;
# adjustments, CSV export, minting/voiding cards need manager or admin.
MANAGER_PASS=
DESK_PASS=
BAR_PASS=

# --- Network ---
PORT=4400
# 127.0.0.1 = only this computer can connect (safe default).
# 0.0.0.0   = reachable from your network / the internet (use behind HTTPS).
HOST=127.0.0.1

# --- Where the database lives. Blank = server/data inside this folder.
# On a host with a persistent disk, point this at the disk, e.g. /data
DATA_DIR=

# --- Only needed if the customer page is hosted on a DIFFERENT site
# (e.g. GitHub Pages). Comma-separate exact origins. Never "*".
ALLOW_ORIGIN=

# --- Signs login sessions. setup fills this in. Changing it signs everyone out.
SESSION_SECRET=9c574f520dca22d3e57a0e90bf837c1a36b89f06df5a0b782d14a2ed5216437e

# --- POS terminals (Toast / CueT webhooks). Blank = terminals are locked out.
# Terminals must send this value in an "X-POS-Key" header.
POS_WEBHOOK_KEY=
