# ============================================================
# BREAKER BLACK — server config
#
# Copy this file to  server/.env  and fill it in. That file is gitignored
# and must never be committed.
#
#   cp server/.env.example server/.env
#
# ============================================================

# Staff & Admin credentials
ADMIN_USER=manager
ADMIN_PASS=breaker-admin-2026
MANAGER_PASS=breaker-manager-2026
BAR_PASS=breaker-bar-2026
DESK_PASS=breaker-desk-2026

# Where the server listens.
# 127.0.0.1 = this machine only (right for local use behind Tailscale).
# 0.0.0.0   = reachable from the network (right on a real host, behind HTTPS).
PORT=4400
HOST=127.0.0.1

# Which sites may call the API from a browser.
# If the guest app is served BY this server, leave this alone.
# If the guest app is on GitHub Pages, list that origin here, e.g.
#   ALLOW_ORIGIN=https://johnnybaab.github.io
# Comma-separate several. Do not ship "*" in production.
ALLOW_ORIGIN=*

# Signs login tokens. Leave blank and the server writes a random one to
# server/data/.secret on first boot and reuses it, which is fine. Set it
# explicitly if you run more than one instance, so tokens work across both.
# Changing it signs everyone out.
SESSION_SECRET=
